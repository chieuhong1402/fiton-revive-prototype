{
 "cleanUrls": true,
 "headers": [
  {
   "source": "/(a|s|fonts)/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/index.json",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/app.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/style.css",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  }
 ]
}